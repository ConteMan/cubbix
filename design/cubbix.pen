                      "fill": "$ColorText",
                      "content": "0.0.3 — 2026-10-29",
                      "lineHeight": "$LineHeightBody",
                      "fontFamily": "$FontFamily",
                      "fontSize": "$FontSizeBody",
                      "fontWeight": "$FontWeightRegular"
                    },
                    {
                      "type": "text",
                      "id": "SAr9S",
                      "fill": "$ColorTextSecondary",
                      "content": "Current",
                      "lineHeight": "$LineHeightBody",
                      "fontFamily": "$FontFamily",
                      "fontSize": "$FontSizeSmall",
                      "fontWeight": "$FontWeightRegular"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "MSiLu",
                  "fill": "$ColorText",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "• What’s new now lives in Settings. Browse by version, then press Esc to go back.",
                  "lineHeight": "$LineHeightBody",
                  "fontFamily": "$FontFamily",
                  "fontSize": "$FontSizeBody",
                  "fontWeight": "$FontWeightRegular"
                },
                {
                  "type": "text",
                  "id": "hRyG7",
                  "fill": "$ColorText",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "• Make Settings roomier if you like. Cubbix remembers the size for next time.",
                  "lineHeight": "$LineHeightBody",
                  "fontFamily": "$FontFamily",
                  "fontSize": "$FontSizeBody",
                  "fontWeight": "$FontWeightRegular"
                },
                {
                  "type": "text",
                  "id": "tDOAn",
                  "fill": "$ColorText",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "• Open a window and Cubbix joins the menu bar and Dock. Close it and the little cat goes back to waiting in the menu bar.",
                  "lineHeight": "$LineHeightBody",
                  "fontFamily": "$FontFamily",
                  "fontSize": "$FontSizeBody",
                  "fontWeight": "$FontWeightRegular"
                }
              ]
            },
            {
              "type": "frame",
              "id": "coYmP",
              "name": "Version entry",
              "width": "fill_container",
              "layout": "vertical",
              "gap": "$Space8",
              "children": [
                {
                  "type": "frame",
                  "id": "vqRIk",
                  "name": "Version and date",
                  "width": "fill_container",
                  "gap": "$Space12",
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "text",
                      "id": "CrbD0",
                      "fill": "$ColorText",
                      "content": "0.0.2 — 2026-10-29",
                      "lineHeight": "$LineHeightBody",
                      "fontFamily": "$FontFamily",
                      "fontSize": "$FontSizeBody",
                      "fontWeight": "$FontWeightRegular"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "S0iq85",
                  "fill": "$ColorText",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "• Automatic updates are up and running. Cubbix will get the next version ready for you.",
                  "lineHeight": "$LineHeightBody",
                  "fontFamily": "$FontFamily",
                  "fontSize": "$FontSizeBody",
                  "fontWeight": "$FontWeightRegular"
                }
              ]
            },
            {
              "type": "frame",
              "id": "BHC06",
              "name": "Version entry",
              "width": "fill_container",
              "layout": "vertical",
              "gap": "$Space8",
              "children": [
                {
                  "type": "frame",
                  "id": "fmy7Z",
                  "name": "Version and date",
                  "width": "fill_container",
                  "gap": "$Space12",
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "text",
                      "id": "wLW88",
                      "fill": "$ColorText",
                      "content": "0.0.1 — 2026-10-29",
                      "lineHeight": "$LineHeightBody",
                      "fontFamily": "$FontFamily",
                      "fontSize": "$FontSizeBody",
                      "fontWeight": "$FontWeightRegular"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "mu4eI",
                  "fill": "$ColorText",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "• Cubbix has moved into the menu bar. Click the cat to find Settings.",
                  "lineHeight": "$LineHeightBody",
                  "fontFamily": "$FontFamily",
                  "fontSize": "$FontSizeBody",
                  "fontWeight": "$FontWeightRegular"
                },
                {
                  "type": "text",
                  "id": "qA8Yk",
                  "fill": "$ColorText",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "• Choose Chinese, English, or your system language, and decide whether Cubbix opens at login.",
                  "lineHeight": "$LineHeightBody",
                  "fontFamily": "$FontFamily",
                  "fontSize": "$FontSizeBody",
                  "fontWeight": "$FontWeightRegular"
                },
                {
                  "type": "text",
                  "id": "U9bOR",
                  "fill": "$ColorText",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "• New versions download for you and wait until you choose “Restart to update”. You can check for updates yourself, too.",
                  "lineHeight": "$LineHeightBody",
                  "fontFamily": "$FontFamily",
                  "fontSize": "$FontSizeBody",
                  "fontWeight": "$FontWeightRegular"
                },
                {
                  "type": "text",
                  "id": "wdRzV",
                  "fill": "$ColorText",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "• Visit “What’s new” to see what just landed.",
                  "lineHeight": "$LineHeightBody",
                  "fontFamily": "$FontFamily",
                  "fontSize": "$FontSizeBody",
                  "fontWeight": "$FontWeightRegular"
                }
              ]
            }
          ]
        }
      ]
    },
